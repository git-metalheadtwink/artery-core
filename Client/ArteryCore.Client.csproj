<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>ArteryCore</RootNamespace>
    <AssemblyName>ArteryCore</AssemblyName>
    <Authors>ArteryCore</Authors>
    <Version>1.3.2</Version>
    <VersionPrefix>1.3.2</VersionPrefix>
    <PackageVersion>1.3.2</PackageVersion>
    <AssemblyVersion>1.3.2</AssemblyVersion>
    <FileVersion>1.3.2</FileVersion>
    <InformationalVersion>1.3.2</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <SptRoot Condition="'$(SptRoot)' == ''">E:\DEV_ENV\SPT_DEV\4.1.X</SptRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath></Reference>
    <Reference Include="Comfort"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath></Reference>
    <Reference Include="spt-common"><HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-common.dll</HintPath></Reference>
    <Reference Include="spt-reflection"><HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-reflection.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.AnimationModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.ParticleSystemModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.UIModule.dll</HintPath></Reference>
  </ItemGroup>

  <PropertyGroup>
    <InstallDir>$(SptRoot)\BepInEx\plugins\ArteryCore</InstallDir>
    <LicenseFile>$(MSBuildProjectDirectory)\..\LICENSE</LicenseFile>
    <NoticeFile>$(MSBuildProjectDirectory)\..\NOTICE</NoticeFile>
    <ReadmeFile>$(MSBuildProjectDirectory)\..\README.md</ReadmeFile>
    <PackageRoot>$(MSBuildProjectDirectory)\..\dist\ArteryCore-$(Version)</PackageRoot>
    <PackageZip>$(MSBuildProjectDirectory)\..\dist\ArteryCore-$(Version).zip</PackageZip>
  </PropertyGroup>

  <Target Name="DeployClient" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(InstallDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(InstallDir)" SkipUnchangedFiles="false" />
  </Target>

  <Target Name="CreateReleasePackage" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(Configuration)' == 'Release' and '$(SkipPackage)' != 'true'">
    <RemoveDir Directories="$(PackageRoot)" />
    <Delete Files="$(PackageZip)" />
    <MakeDir Directories="$(PackageRoot)\BepInEx\plugins\ArteryCore" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageRoot)\BepInEx\plugins\ArteryCore" />
    <Copy SourceFiles="$(LicenseFile)" DestinationFolder="$(PackageRoot)\BepInEx\plugins\ArteryCore" />
    <Copy SourceFiles="$(NoticeFile)" DestinationFolder="$(PackageRoot)\BepInEx\plugins\ArteryCore" />
    <Copy SourceFiles="$(ReadmeFile)" DestinationFolder="$(PackageRoot)\BepInEx\plugins\ArteryCore" Condition="Exists('$(ReadmeFile)')" />
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="ArteryCore release package created: $(PackageZip)" />
  </Target>

</Project>
